<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- 测试项目位于本目录下，默认 **/*.cs 通配符会将其 obj/ 下生成的
       AssemblyAttributes.cs（文件名含逗号）错误纳入编译，导致
       CS0579 TargetFrameworkAttribute 重复；Content/None 默认项也会
       把其 bin/obj 当作内容复制（产生嵌套路径）。显式排除整个测试项目目录。 -->
  <ItemGroup>
    <Compile Remove="Huamishu.Api.Tests\**" />
    <Content Remove="Huamishu.Api.Tests\**" />
    <EmbeddedResource Remove="Huamishu.Api.Tests\**" />
    <None Remove="Huamishu.Api.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
  </ItemGroup>

</Project>
